{
  "name": "zesira-studio-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3055",
    "dev:3000": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "dev:stop": "bash -c 'for p in 3000 3055 3050; do x=$(lsof -ti :$p 2>/dev/null); [ -n \"$x\" ] && kill -9 $x; done; rm -f .next/dev/lock; echo \"Eski next dev / port temizlendi.\"'",
    "start:dev": "bash scripts/start-dev.sh",
    "dev:fresh": "npm run start:dev",
    "emergency": "next build && next start --hostname 127.0.0.1 --port 3050",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.3",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
